# Turso Cloud Database Credentials
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token"

# Server-Only Cron & Admin Sync Authentication (NEVER prefix with NEXT_PUBLIC_)
CRON_SECRET="replace_with_a_strong_random_secret"
FULL_SYNC_SECRET="replace_with_optional_separate_full_archive_secret"

# Plan C Zero-Cost Cloudflare Worker Edge Relay & Optional Shared Relay Secret
CLOUDFLARE_WORKER_PROXY_URL="https://nlcb-edge-proxy.daryl-created.workers.dev"
CLOUDFLARE_PROXY_SECRET=""

# Web Push Notification VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@onlineresults.tt"
